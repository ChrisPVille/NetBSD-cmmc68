#	$NetBSD: CMMC68,v 1.1 2024/01/01 00:00:00 cmmc68 Exp $
#
# Kernel configuration file for CMMC68 (MC68010 with custom MMU)

# Standard options
include		"arch/cmmc68/conf/std.cmmc68"

# CPU identification
ident		CMMC68

# Define CMMC68 for platform-specific code
makeoptions	CPPFLAGS="-DCMMC68 -DNO_CRYPTO_SELFTEST"
makeoptions	COPTS="-Os"		# Optimize for size

# Maximum number of users
maxusers	2

# Disable unused subsystems
no options	AIO			# POSIX async I/O
no options	MQUEUE			# POSIX message queues
no options	COREDUMP		# Core dumps impractical on 8MB
no options	EXEC_AOUT		# ELF only
no options	COMPAT_UTILS		# No compat needed

# Standard system options
# options 	INET		# IP + TCP + UDP + ICMP - disabled to reduce kernel size

# Memory options
options 	PAGER_MAP_SIZE=0x00040000	# 256KB pager map (default 16MB is absurd)
options		VMSWAP_DEFAULT_PLAINTEXT	# Skip swap encryption (no AES on 68010)

# Console options
options 	CONSPEED=19200	# Console speed
# options	CONSDEV_DUART	# Use DUART channel A as console (default: MFP)

# Memory disk for root filesystem (ramdisk loaded separately by bootloader)
options		MEMORY_DISK_HOOKS
options		MEMORY_DISK_IS_ROOT
options		MEMORY_DISK_DYNAMIC

# Filesystem options
file-system	FFS		# Fast filesystem
# file-system	MSDOSFS		# MS-DOS/FAT filesystem - disabled to reduce kernel size
# file-system	PUFFS		# Userspace filesystems (FUSE equivalent) - disabled

# Device configuration

# Mainbus (system bus)
mainbus0	at root

# MC68901 MFP (Multi-Function Peripheral)
mfp0		at mainbus0

# Serial console (polled MFP character device; no attachment needed)

# Clock
clock0		at mfp?

# MC68230 PI/T (timer + parallel port)
pit0		at mainbus0

# MC68681 DUART (dual serial)
duart0		at mainbus0

# Memory device
mem0		at mainbus0

# Pseudo devices
pseudo-device	md			# Memory disk device
# pseudo-device	loop		# Loopback network - requires INET
pseudo-device	pty		# Pseudo ttys
# pseudo-device	putter		# Required for PUFFS - disabled

# Pipe implementation using socketpair (smaller than dedicated pipe code)
options		PIPE_SOCKETPAIR

# Root configuration
config		netbsd root on ? type ?

# Make options
makeoptions	TEXTADDR="0x00C00000"
