#	$NetBSD$

SRCDIRS bin sbin usr.bin

# copy the crunched binary, link to it, and kill it
PROG	bin/cat
PROG	bin/chmod
PROG	bin/cp
PROG	bin/echo
PROG	bin/ln
PROG	bin/ls
PROG	bin/mkdir
PROG	bin/pwd
PROG	bin/rm
PROG	bin/sh
PROG	bin/sync

PROG	sbin/dmesg
PROG	sbin/init
PROG	sbin/mknod
PROG	sbin/mount
PROG	sbin/mount_ffs
PROG	sbin/reboot	sbin/halt
PROG	sbin/umount

PROG	bin/df
PROG	sbin/sysctl
PROG	sbin/vmstat

PROG	bin/ps
PROG	sbin/pmap
PROG	bin/kill
PROG	bin/uname
PROG	bin/id
PROG	bin/dd
PROG	bin/sleep

ARGVLN	sh -sh

# libhack.o is built by Makefile & included Makefile.inc
LIBS	libhack.o -ledit -lutil -lterminfo -lcrypt -lkvm -lm -lprop

# various files that we need in /etc for the install
COPY	${NETBSDSRCDIR}/etc/master.passwd	etc/master.passwd
COPY	${NETBSDSRCDIR}/etc/group		etc/group

# shell profile
COPY	${CURDIR}/dot.profile			.profile
